npx prisma validateNODE_ENV=staging
APP_ENV=staging
API_PORT=3000
APP_VERSION=0.1.0
GIT_COMMIT_SHA=__CI_COMMIT_SHA__
DATABASE_URL=postgresql://__STAGING_DB_USER__:__STAGING_DB_PASSWORD__@postgres:5432/__STAGING_DB_NAME__?schema=public&connection_limit=20
REDIS_URL=redis://:__STAGING_REDIS_PASSWORD__@redis:6379
JWT_SECRET=__CI_SECRET__
CORS_ORIGIN=https://${PUBLIC_DOMAIN},https://${ADMIN_DOMAIN}
S3_BUCKET_NAME=__STAGING_BUCKET__
S3_BUCKET_PREFIX=staging
S3_REGION=__S3_REGION__
S3_ENDPOINT=__S3_ENDPOINT__
S3_PUBLIC_BASE_URL=__CDN_PUBLIC_BASE_URL__
S3_ACCESS_KEY=__CI_SECRET__
S3_SECRET_KEY=__CI_SECRET__
S3_FORCE_PATH_STYLE=false
PUBLIC_DOMAIN=staging.example.com
ADMIN_DOMAIN=admin-staging.example.com
API_DOMAIN=api-staging.example.com
REGISTRY_IMAGE_API=ghcr.io/OWNER/REPO/api
REGISTRY_IMAGE_WEB=ghcr.io/OWNER/REPO/web
REGISTRY_IMAGE_ADMIN=ghcr.io/OWNER/REPO/admin
IMAGE_TAG=__CI_COMMIT_SHA__
NEXT_PUBLIC_API_URL=https://${API_DOMAIN}
NEXT_PUBLIC_WS_URL=https://${API_DOMAIN}
NEXT_PUBLIC_APP_URL=https://${PUBLIC_DOMAIN}
VITE_API_URL=https://${API_DOMAIN}/api/v1
NEXT_PUBLIC_ERROR_MONITORING_DSN=
VITE_ERROR_MONITORING_DSN=
